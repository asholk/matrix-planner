{
  "version": 1,
  "description": "Общие примеры правил повтора (ТЗ §3.3) для плагина (TypeScript) и компаньона (Swift). Даты — YYYY-MM-DD, дата-время — плавающее YYYY-MM-DDTHH:mm. 'task' — свойства задачи в форме YAML; 'expected.patch' — изменённые свойства (остальные не трогаются).",
  "series": [
    { "name": "monthly from Jan 31", "rule": "monthly", "anchor": "2026-01-31", "count": 5, "expected": ["2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30", "2026-05-31"] },
    { "name": "monthly from Jan 31 in leap year", "rule": "monthly", "anchor": "2028-01-31", "count": 3, "expected": ["2028-01-31", "2028-02-29", "2028-03-31"] },
    { "name": "monthly from the 30th across year end", "rule": "monthly", "anchor": "2026-10-30", "count": 6, "expected": ["2026-10-30", "2026-11-30", "2026-12-30", "2027-01-30", "2027-02-28", "2027-03-30"] },
    { "name": "yearly from Feb 29", "rule": "yearly", "anchor": "2028-02-29", "count": 5, "expected": ["2028-02-29", "2029-02-28", "2030-02-28", "2031-02-28", "2032-02-29"] },
    { "name": "daily across year end", "rule": "daily", "anchor": "2026-12-30", "count": 4, "expected": ["2026-12-30", "2026-12-31", "2027-01-01", "2027-01-02"] },
    { "name": "weekly", "rule": "weekly", "anchor": "2026-10-10", "count": 3, "expected": ["2026-10-10", "2026-10-17", "2026-10-24"] },
    { "name": "none has a single occurrence", "rule": "none", "anchor": "2026-10-10", "count": 3, "expected": ["2026-10-10"] }
  ],
  "nextAfter": [
    { "name": "monthly after Feb 28 returns to the 31st", "rule": "monthly", "anchor": "2026-01-31", "after": "2026-02-28", "skip": [], "expected": "2026-03-31" },
    { "name": "monthly in the middle of February", "rule": "monthly", "anchor": "2026-01-31", "after": "2026-02-10", "skip": [], "expected": "2026-02-28" },
    { "name": "yearly Feb 29 to non-leap year", "rule": "yearly", "anchor": "2028-02-29", "after": "2028-02-29", "skip": [], "expected": "2029-02-28" },
    { "name": "yearly back to Feb 29 in leap year", "rule": "yearly", "anchor": "2028-02-29", "after": "2031-02-28", "skip": [], "expected": "2032-02-29" },
    { "name": "weekly strictly after date", "rule": "weekly", "anchor": "2026-10-03", "after": "2026-10-10", "skip": [], "expected": "2026-10-17" },
    { "name": "daily skips completed dates", "rule": "daily", "anchor": "2026-10-01", "after": "2026-10-10", "skip": ["2026-10-11"], "expected": "2026-10-12" },
    { "name": "date before anchor gives anchor", "rule": "monthly", "anchor": "2026-03-15", "after": "2026-01-01", "skip": [], "expected": "2026-03-15" },
    { "name": "none has no next occurrence", "rule": "none", "anchor": "2026-10-10", "after": "2026-10-01", "skip": [], "expected": null }
  ],
  "complete": [
    {
      "name": "single task",
      "task": { "due": "2026-10-10T17:00", "repeat": "none", "repeat_anchor": null, "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2026-10-10T13:20",
      "expected": { "kind": "change", "patch": { "done": true, "completed": "2026-10-10T13:20" } }
    },
    {
      "name": "single task already done is skipped",
      "task": { "due": "2026-10-10", "repeat": "none", "repeat_anchor": null, "done": true, "completed": "2026-10-10T09:00", "completions": [] },
      "instanceDate": null, "now": "2026-10-10T13:20",
      "expected": { "kind": "skip" }
    },
    {
      "name": "single task with another date is stale",
      "task": { "due": "2026-10-10", "repeat": "none", "repeat_anchor": null, "done": false, "completed": null, "completions": [] },
      "instanceDate": "2026-10-11", "now": "2026-10-10T13:20",
      "expected": { "kind": "stale", "reason": "instance-mismatch" }
    },
    {
      "name": "monthly Jan 31 to Feb 28, time kept",
      "task": { "due": "2026-01-31T09:00", "repeat": "monthly", "repeat_anchor": "2026-01-31", "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2026-01-31T10:00",
      "expected": { "kind": "change", "patch": { "completions": ["2026-01-31"], "due": "2026-02-28T09:00" } }
    },
    {
      "name": "monthly Feb 28 back to Mar 31 by anchor",
      "task": { "due": "2026-02-28T09:00", "repeat": "monthly", "repeat_anchor": "2026-01-31", "done": false, "completed": null, "completions": ["2026-01-31"] },
      "instanceDate": "2026-02-28", "now": "2026-02-28T08:00",
      "expected": { "kind": "change", "patch": { "completions": ["2026-01-31", "2026-02-28"], "due": "2026-03-31T09:00" } }
    },
    {
      "name": "empty anchor is fixed on first completion",
      "task": { "due": "2026-01-31", "repeat": "monthly", "repeat_anchor": null, "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2026-01-31T12:00",
      "expected": { "kind": "change", "patch": { "completions": ["2026-01-31"], "due": "2026-02-28", "repeat_anchor": "2026-01-31" } }
    },
    {
      "name": "yearly Feb 29 to Feb 28",
      "task": { "due": "2028-02-29", "repeat": "yearly", "repeat_anchor": "2028-02-29", "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2028-02-29T20:00",
      "expected": { "kind": "change", "patch": { "completions": ["2028-02-29"], "due": "2029-02-28" } }
    },
    {
      "name": "yearly Feb 28 back to Feb 29 in leap year",
      "task": { "due": "2031-02-28", "repeat": "yearly", "repeat_anchor": "2028-02-29", "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2031-02-28T10:00",
      "expected": { "kind": "change", "patch": { "completions": ["2031-02-28"], "due": "2032-02-29" } }
    },
    {
      "name": "overdue daily moves to the first occurrence after completion date",
      "task": { "due": "2026-10-07T08:00", "repeat": "daily", "repeat_anchor": "2026-10-01", "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2026-10-10T13:20",
      "expected": { "kind": "change", "patch": { "completions": ["2026-10-07"], "due": "2026-10-11T08:00" } }
    },
    {
      "name": "overdue weekly does not create missed occurrences",
      "task": { "due": "2026-10-03", "repeat": "weekly", "repeat_anchor": "2026-10-03", "done": false, "completed": null, "completions": [] },
      "instanceDate": null, "now": "2026-10-10T13:20",
      "expected": { "kind": "change", "patch": { "completions": ["2026-10-03"], "due": "2026-10-17" } }
    },
    {
      "name": "repeated completion of D is skipped",
      "task": { "due": "2026-10-11", "repeat": "daily", "repeat_anchor": "2026-10-01", "done": false, "completed": null, "completions": ["2026-10-10"] },
      "instanceDate": "2026-10-10", "now": "2026-10-10T13:25",
      "expected": { "kind": "skip" }
    },
    {
      "name": "occurrence before due is stale",
      "task": { "due": "2026-10-11", "repeat": "daily", "repeat_anchor": "2026-10-01", "done": false, "completed": null, "completions": [] },
      "instanceDate": "2026-10-09", "now": "2026-10-10T13:20",
      "expected": { "kind": "stale", "reason": "instance-passed" }
    },
    {
      "name": "future occurrence keeps due",
      "task": { "due": "2026-10-10", "repeat": "weekly", "repeat_anchor": "2026-10-03", "done": false, "completed": null, "completions": [] },
      "instanceDate": "2026-10-17", "now": "2026-10-10T13:20",
      "expected": { "kind": "change", "patch": { "completions": ["2026-10-17"] } }
    },
    {
      "name": "next due skips completed future occurrence",
      "task": { "due": "2026-10-10", "repeat": "weekly", "repeat_anchor": "2026-10-03", "done": false, "completed": null, "completions": ["2026-10-17"] },
      "instanceDate": null, "now": "2026-10-10T13:20",
      "expected": { "kind": "change", "patch": { "completions": ["2026-10-10", "2026-10-17"], "due": "2026-10-24" } }
    },
    {
      "name": "date that is not an occurrence is stale",
      "task": { "due": "2026-10-10", "repeat": "weekly", "repeat_anchor": "2026-10-03", "done": false, "completed": null, "completions": [] },
      "instanceDate": "2026-10-12", "now": "2026-10-10T13:20",
      "expected": { "kind": "stale", "reason": "not-occurrence" }
    }
  ],
  "uncomplete": [
    {
      "name": "single task back to work",
      "task": { "due": "2026-10-10", "repeat": "none", "repeat_anchor": null, "done": true, "completed": "2026-10-10T13:20", "completions": [] },
      "instanceDate": null,
      "expected": { "kind": "change", "patch": { "done": false, "completed": null } }
    },
    {
      "name": "single task not done is skipped",
      "task": { "due": "2026-10-10", "repeat": "none", "repeat_anchor": null, "done": false, "completed": null, "completions": [] },
      "instanceDate": null,
      "expected": { "kind": "skip" }
    },
    {
      "name": "due returns to earlier date",
      "task": { "due": "2026-10-11T08:00", "repeat": "daily", "repeat_anchor": "2026-10-01", "done": false, "completed": null, "completions": ["2026-10-09", "2026-10-10"] },
      "instanceDate": "2026-10-10",
      "expected": { "kind": "change", "patch": { "completions": ["2026-10-09"], "due": "2026-10-10T08:00" } }
    },
    {
      "name": "future occurrence keeps due",
      "task": { "due": "2026-10-10", "repeat": "weekly", "repeat_anchor": "2026-10-03", "done": false, "completed": null, "completions": ["2026-10-17"] },
      "instanceDate": "2026-10-17",
      "expected": { "kind": "change", "patch": { "completions": [] } }
    },
    {
      "name": "date not in completions is skipped",
      "task": { "due": "2026-10-11", "repeat": "daily", "repeat_anchor": "2026-10-01", "done": false, "completed": null, "completions": ["2026-10-09"] },
      "instanceDate": "2026-10-10",
      "expected": { "kind": "skip" }
    },
    {
      "name": "default is the last completion",
      "task": { "due": "2026-03-31", "repeat": "monthly", "repeat_anchor": "2026-01-31", "done": false, "completed": null, "completions": ["2026-01-31", "2026-02-28"] },
      "instanceDate": null,
      "expected": { "kind": "change", "patch": { "completions": ["2026-01-31"], "due": "2026-02-28" } }
    }
  ]
}
