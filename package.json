{
  "name": "matrix-planner",
  "version": "0.2.7",
  "description": "Eisenhower matrix planner with calendar and lock screen wallpapers, stored as plain Markdown notes.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/build-styles.mjs",
    "styles": "node scripts/build-styles.mjs",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "keywords": ["obsidian", "planner", "eisenhower", "tasks"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
